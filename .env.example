# Copy to .env and fill with Razorpay test keys from your dashboard.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
JWT_SECRET=replace_with_a_long_random_secret
PORT=4000
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
# Optional SMTP for verification and password-reset email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_user
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=no-reply@example.com
